# For local runs only: copy to .env (git-ignored) and fill in. On GitHub these are repository secrets instead.
MAIL_MODE=dry_run            # graph = really send; dry_run = write outbox/report.html
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-5.6-terra
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
MAIL_FROM=                   # the mailbox the Azure app sends as
MAIL_TO=                     # your Outlook address
